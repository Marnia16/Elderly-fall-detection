# ==============================================================================
# Smart Elderly Fall Detection & Alert System - Environment Configuration
# ==============================================================================

# --- Application Environment ---
ENV=development
PORT=8000
HOST=0.0.0.0

# --- SQLite Database Storage ---
# Optional custom database path (defaults to backend/app/data/incidents.db)
DATABASE_PATH=app/data/incidents.db

# --- CORS Configuration ---
# Comma-separated allowed frontend origins or *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Notification Service Configuration ---
# Mode: "demo" (logs alerts locally without sending emails) or "smtp" (dispatches actual emails)
NOTIFICATION_MODE=demo

# Primary emergency recipient email or SMS gateway
ALERT_RECIPIENT_EMAIL=caregiver-team@hospital.org

# SMTP Settings (Required only when NOTIFICATION_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts.elderlycare@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=alerts.elderlycare@gmail.com
SMTP_USE_TLS=true

# --- Frontend Client Configuration (.env.local in frontend/) ---
# VITE_API_BASE_URL=http://localhost:8000/api
